{
  "name": "johnykvsky/quidam",
  "type": "library",
  "description": "Modern, fast and seedable fake / dummy data generator for PHP 8.4+",
  "keywords": [
    "fake data",
    "dummy data",
    "faker",
    "generator",
    "test data",
    "fixtures",
    "seed",
    "cli"
  ],
  "homepage": "https://github.com/johnykvsky/quidam",
  "license": "MIT",
  "authors": [
    {
      "name": "Johny Kvsky",
      "homepage": "https://github.com/johnykvsky"
    }
  ],
  "support": {
    "issues": "https://github.com/johnykvsky/quidam/issues",
    "source": "https://github.com/johnykvsky/quidam"
  },
  "require": {
    "php": "^8.4",
    "ext-mbstring": "*",
    "psr/clock": "^1.0",
    "psr/container": "^2.0"
  },
  "require-dev": {
    "phpstan/extension-installer": "^1.4.3",
    "phpstan/phpstan": "^2.3.0",
    "phpunit/phpunit": "^12.5.14",
    "slevomat/coding-standard": "^8.31.1",
    "squizlabs/php_codesniffer": "^4.0.4"
  },
  "bin": [
    "bin/quidam"
  ],
  "autoload": {
    "psr-4": {
      "Quidam\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Quidam\\Test\\": "test/"
    }
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "phpstan/extension-installer": true,
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "bin-dir": "vendor-bin"
  },
  "scripts": {
    "test": "vendor-bin/phpunit --no-coverage",
    "test-coverage": "vendor-bin/phpunit",
    "check-style": [
      "@php -r \"is_dir('.build') || mkdir('.build');\"",
      "vendor-bin/phpcs -p --standard=phpcs.xml.dist --runtime-set ignore_warnings_on_exit 1"
    ],
    "fix-style": [
      "@php -r \"is_dir('.build') || mkdir('.build');\"",
      "vendor-bin/phpcbf -p --standard=phpcs.xml.dist --runtime-set ignore_errors_on_exit 1 --runtime-set ignore_warnings_on_exit 1"
    ],
    "phpstan": "vendor-bin/phpstan analyse",
    "seed-snapshot": [
      "@putenv UPDATE_SEED_SNAPSHOT=1",
      "vendor-bin/phpunit --no-coverage --filter 'Quidam\\\\Test\\\\Seed\\\\SeededOutputTest'"
    ]
  }
}
